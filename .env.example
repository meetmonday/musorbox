# Cloudflare Tunnel token (from Cloudflare Zero Trust / One Dashboard:
# Networks -> Tunnels -> your tunnel -> Configure -> docker). Used to run
# cloudflared inside the container. If left empty, the tunnel is not started.
TUNNEL_TOKEN=

# Externally reachable URL (must match the Cloudflare hostname).
PUBLIC_BASE_URL=https://your-domain.example

# Session signing secret. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Optional: allow plain-http fetches of remote actors by host comma list.
# Defaults to loopback (localhost, 127.0.0.1, ::1).
#AP_ALLOW_INSECURE_HOSTS=

# Optional: host port for the app (only for local debugging).
#APP_PORT=3000

# Optional: verbose ActivityPub inbox logging (1 to enable).
#AP_DEBUG=0

# Optional: comma-separated usernames forced to the admin role on startup.
#ADMIN_USERNAME=